[Unit]
Description=Person 2 Workload Simulator
After=network.target

[Service]
Type=notify
NotifyAccess=all
User=conno
Group=conno
WorkingDirectory=/home/conno/unix-midterm-project/scripts
ExecStart=/home/conno/unix-midterm-project/scripts/workload.sh
Restart=always
RestartSec=5
WatchdogSec=30s
TimeoutStartSec=30s
TimeoutStopSec=15s

[Install]
WantedBy=multi-user.target