[Unit]
Description=Person 2 Workload Simulator
After=network.target

[Service]
Type=notify
NotifyAccess=all
User=doctorgamer01
Group=doctorgamer01
WorkingDirectory=/home/doctorgamer01/person2-lab
ExecStart=/home/doctorgamer01/person2-lab/workload.sh
Restart=always
RestartSec=5
WatchdogSec=30s
TimeoutStartSec=30s
TimeoutStopSec=15s

[Install]
WantedBy=multi-user.target